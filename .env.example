# EnZIME build-time environment (shared-resource storage policy).
#
# Every key below is BUILD-ONLY: build.rs compiles these values into the
# reader binary and scripts/build_set.py forwards exactly these six keys into
# the build snapshot `.env`. They are not read at runtime, and no other
# secrets belong in this file. Copy to `.env` and adjust; empty optional roots
# mean platform defaults / no configured card.

# App identity (not the large-resource storage namespace).
VITE_APP_NAMESPACE=mba.robin.enzime

# Large resources are always shared; no private storage mode exists.
VITE_STORAGE_SCOPE=common

# Organization-wide storage namespace every shared root must end with.
ENZIME_STORAGE_NAMESPACE=mba.robin

# Optional absolute desktop common root ending in the storage namespace.
# Default: <platform data directory>/mba.robin, resolved independently of
# the app identifier. Empty means the platform default.
ENZIME_SHARED_STORAGE_ROOT=

# Optional absolute Android primary common root (OEM/build override).
# Default: /storage/emulated/0/mba.robin. Empty means the platform default.
ENZIME_SHARED_STORAGE_ROOT_ANDROID=

# Optional absolute common root on a mounted SD card, ending in the storage
# namespace. The card mount parent must already exist; it is never created.
# Empty means no configured card (Android still enumerates real volumes).
ENZIME_SHARED_SDCARD_ROOT=
