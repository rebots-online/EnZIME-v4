# Build output (disposable)
target/
node_modules/
**/build/
apps/*/dist/

# Release artifacts ARE tracked (CC12 / BUILD floor)
!/dist/

# Never any tmp (I-8)
.tmp/

# VENDOR/ trees are ASSIMILATED plain source in our tree (INC-15) — not
# submodules, no embedded .git. They are tracked and committed.

# Local build signing values; never enter snapshots or source publication.
/signing/build-credentials.json

# Per-session agent state written by local tooling hooks (not project source).
.anchor/
.omp/

# Outputs above GitHub's 100 MB object limit stay on disk in dist/ and in the build
# manifest (name, size, SHA-256) but are not committed; there is no LFS budget.
/dist/*-android-universal-release-signed.aab
/dist/*-android-native-debug-symbols.zip
# 1.17.05542 only: its APK carried unstripped native libraries (1.2 GB).
/dist/enzime-reader-v1.17.05542-android-universal-release-signed.apk
