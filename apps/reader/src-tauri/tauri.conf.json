{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnZIME Reader",
  "version": "1.8.21560",
  "identifier": "mba.robin.enzime",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:41847",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EnZIME Reader",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "x": 200,
        "y": 200,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi"],
    "icon": [
      "icons/icon.png"
    ],
    "copyright": "Copyright (C) 2026 Robin L. M. Cheung, MBA. All rights reserved.",
    "publisher": "Robin L. M. Cheung, MBA",
    "category": "Education"
  }
}
